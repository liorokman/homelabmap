# homelabmap settings. Copy to .env and fill in; .env is gitignored and
# never baked into images. Used by compose.yaml and deploy/render.py.

# --- Images and version
HOMELABMAP_IMAGE_PREFIX=ghcr.io/liorokman/homelabmap
HOMELABMAP_VERSION=latest

# --- Web UI
# Where users reach the UI (behind your HTTPS reverse proxy).
HOMELABMAP_PUBLIC_URL=https://homelabmap.example.net
# Host and port the UI container publishes on (compose.yaml).
HOMELABMAP_UI_BIND=127.0.0.1:8080
# Shared secret between scanner and web (>= 32 chars): openssl rand -hex 32
HOMELABMAP_AGENT_TOKEN=

# --- Login (OpenID Connect, authorization code + PKCE)
# Optional: leave the issuer and client ID empty to sign in with a username
# and password instead, created on first run (setup code in the web log).
# Otherwise create a client at your identity provider with the redirect URIs
#   https://homelabmap.example.net/auth/callback
#   https://homelabmap.example.net/signin?signed-out=1
# The secret is only needed for a confidential client.
# e.g. https://auth.example.net/
HOMELABMAP_OIDC_ISSUER=
HOMELABMAP_OIDC_CLIENT_ID=
HOMELABMAP_OIDC_CLIENT_SECRET=
# Optional, comma separated; empty = any user the identity provider lets through.
HOMELABMAP_OIDC_ALLOWED_GROUPS=
# Optional label for the sign-in button ("Sign in with ...").
HOMELABMAP_OIDC_PROVIDER_NAME=

# --- What to scan
HOMELABMAP_SUBNETS=192.168.1.0/24
# Optional
TZ=

# --- SNMP (v2c community, or v3 user)
HOMELABMAP_SNMP_VERSION=2c
HOMELABMAP_SNMP_COMMUNITY=

# --- UniFi OS console: URL and an API key (Settings > Control Plane > Integrations)
HOMELABMAP_UNIFI_URL=
HOMELABMAP_UNIFI_API_KEY=
HOMELABMAP_UNIFI_INSECURE_TLS=

# --- Proxmox VE: read-only API token (see README, "Proxmox service account")
HOMELABMAP_PVE_URL=
HOMELABMAP_PVE_TOKEN_ID=
HOMELABMAP_PVE_TOKEN_SECRET=
HOMELABMAP_PVE_INSECURE_TLS=

# --- Cosmos server (optional): its containers and routes. API token with ONLY
# "Resources Read" and "Configuration Read", IP-whitelisted to the scanner host.
HOMELABMAP_COSMOS_URL=
HOMELABMAP_COSMOS_TOKEN=

# --- Deploying on Cosmos with deploy/render.py only
HOMELABMAP_HOST=homelabmap.example.net
HOMELABMAP_LAN_CIDR=192.168.1.0/24
HOMELABMAP_DATA_VOLUME=homelabmap-data
# Optional: database file inside the volume (default /data/homelabmap.db)
HOMELABMAP_DB=
